{
  "name": "fluxmeld",
  "version": "0.1.0",
  "description": "FluxMeld - 本地 AI 路由工作台，提供多服务商账户池、OpenAI 兼容网关与安全工具调用",
  "main": "./out/main/index.js",
  "author": {
    "name": "FluxMeld Contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenYJ2000/FluxMeld.git"
  },
  "bugs": {
    "url": "https://github.com/chenYJ2000/FluxMeld/issues"
  },
  "homepage": "https://github.com/chenYJ2000/FluxMeld#readme",
  "contributors": [
    {
      "name": "xiaoY233 and the upstream Chat2API contributors",
      "url": "https://github.com/xiaoY233/Chat2API/graphs/contributors"
    },
    {
      "name": "chenYJ2000",
      "url": "https://github.com/chenYJ2000"
    },
    {
      "name": "FluxMeld Contributors"
    }
  ],
  "license": "GPL-3.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:win": "electron-vite dev",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer && npm run typecheck:server",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source-artifacts": "node scripts/check-source-artifacts.js",
    "build": "npm run check:source-artifacts && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "web:build": "node scripts/build-web.mjs",
    "web:start": "node out/server/index.cjs",
    "web:dev": "npm run web:build && npm run web:start",
    "start:sandbox": "electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps",
    "prebuild:check": "node scripts/prebuild-check.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win32": "npm run build && electron-builder --win --ia32",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac-arm": "npm run build && electron-builder --mac --arm64",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --mac --linux",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@koa/router": "^15.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^3.0.6",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^12.0.1",
    "lucide-react": "^0.454.0",
    "mime-types": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.2.7",
    "tailwind-merge": "^2.5.4",
    "zstd-codec": "^0.1.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "io.fluxmeld.desktop",
    "productName": "FluxMeld",
    "copyright": "Copyright © 2026 FluxMeld Contributors. Includes code from Chat2API contributors.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sha3_wasm_bg.7b9ca65ddd.wasm",
        "to": "sha3_wasm_bg.7b9ca65ddd.wasm"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/electron-updater/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "fmd",
        "name": "FluxMeld Config",
        "description": "FluxMeld 配置文件",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "FluxMeld",
        "schemes": [
          "fluxmeld"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FluxMeld",
      "license": "LICENSE",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "FluxMeld Contributors",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "FluxMeld",
        "Comment": "统一管理多个 AI 服务提供商",
        "Categories": "Utility;Network;",
        "StartupWMClass": "fluxmeld"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "priority": "optional",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
